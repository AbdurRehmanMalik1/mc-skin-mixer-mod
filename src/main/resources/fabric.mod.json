{
	"schemaVersion": 1,
	"id": "skinmixer",
	"version": "${version}",
	"name": "Skin Mixer",
	"description": "Change your skin in game: mix the head, body, arms and legs of different skins into one outfit. Players with the mod see each other's outfits.",
	"authors": [
		"firstwemine1-mc-dev"
	],
	"license": "MIT",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.firstwemine1.skinmixer.SkinMixer"
		],
		"client": [
			"net.firstwemine1.skinmixer.client.SkinMixerClient"
		]
	},
	"mixins": [
		{
			"config": "skinmixer.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
